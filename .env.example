NODE_ENV=development
PORT=3000
GRPC_PORT=50051
GRPC_REFLECTION=true
API_PREFIX=api/v1

# Uploads (HTTP multer + gRPC document streaming)
UPLOAD_DEST=uploads
UPLOAD_MAX_MB=5
UPLOAD_GRPC_MAX_MB=100
ALLOWED_ORIGINS=*

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=nestjs_boilerplate
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Admin seed (migration 1747128000000-SeedAdminUser)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

